<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources/en-US_Stopwords.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources/EnglishPOS.nbin" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources/EnglishSD.nbin" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources/EnglishTok.nbin" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources/tagdict" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="OpenNLP">
      <HintPath>lib/OpenNLP.dll</HintPath>
    </Reference>
    <Reference Include="SharpEntropy">
      <HintPath>lib/SharpEntropy.dll</HintPath>
    </Reference>
    <Reference Include="SharpWordNet">
      <HintPath>lib/SharpWordNet.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
